# Topic files live next to this one. Set ZSH_CONFIG to relocate.
ZSH_CONFIG="${ZSH_CONFIG:-$HOME/dotfiles/config/zsh}"

# ----------------------------------------------------------------------------
# Oh My Zsh
# ----------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="mm/dd/yyyy"

plugins=(git z dotenv kubectl zsh-syntax-highlighting)

[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ----------------------------------------------------------------------------
# Pure ZSH Theme (https://github.com/sindresorhus/pure)
# ----------------------------------------------------------------------------
autoload -U promptinit; promptinit
prompt pure

# ----------------------------------------------------------------------------
# Topic files — ordered, not globbed: path must precede tools that call PATH
# binaries, and aliases must come after oh-my-zsh.
# ----------------------------------------------------------------------------
for topic in path tools work aliases; do
  [ -s "$ZSH_CONFIG/$topic.zsh" ] && source "$ZSH_CONFIG/$topic.zsh"
done
unset topic
